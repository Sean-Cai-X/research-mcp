# Build output (保留 build/release.args / build/debug.args 用于 GN 通用模板)
build/*
!build/release.args
!build/debug.args
build-cdp/
build-webview2/
build-rel/
build-release/
build-debug/
out/
bin/
lib/

# Binary images / screenshots / docs (use network source, not in repo)
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.ico
*.svg
assets/screenshots/

# Visual Studio
.vs/
*.user
*.suo
*.sln.docstates
*.vcxproj.filters
*.vcxproj.user

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
*.cmake
!CMakeLists.txt

# Dependencies: 仓库只存源码, 预编译二进制/运行时包全排除
# FetchContent 下载缓存 (CMake configure 时自动拉, 不在仓库里)
_fetchcontent/
cmake-build-*/

# NuGet 临时包 (FetchContent 下载后解压, .nupkg 本身是 zip)
*.nupkg

# third_party/curl + third_party/WebView2 已删除 (FetchContent 替代)
# third_party/sqlite (amalgamation 源码) + third_party/json (单头) 保留

# Runtime data
webview2-data/
profiles/
data/
*.log
.env
*.db
*.db-wal
*.db-shm
mcp_pid.txt

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# IDE
.idea/
.vscode/
*.swp
/_tmp_verify.py
/_tmp_analyze.py
/other
/next.txt
/next2.txt

