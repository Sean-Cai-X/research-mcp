!build/release.args
!build/debug.args
build-rel/
build-release/
build-debug/
out/
bin/
lib/

# Binary images / screenshots / docs (use network source, not in repo)
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.ico
*.svg
assets/screenshots/

# Visual Studio
.vs/
*.user
*.suo
*.sln.docstates
*.vcxproj.filters
